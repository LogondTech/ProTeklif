{
  "name": "proteklif",
  "version": "0.1.0",
  "description": "Küçük işletmeler için local-first teklif yönetimi",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "better-sqlite3": "^12.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "vite": "^8.1.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.proteklif.app",
    "productName": "ProTeklif",
    "asarUnpack": ["**/node_modules/better-sqlite3/**/*"],
    "files": ["dist/**/*", "src/main/**/*", "src/preload/**/*", "database/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": "nsis" }
  }
}
